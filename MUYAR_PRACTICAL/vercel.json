{
  "version": 2,
  "builds": [
    {
      "src": "MUYAR_PRACTICAL/client/server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "MUYAR_PRACTICAL/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "source": "/students/(.*)",
      "destination": "/MUYAR_PRACTICAL/client/server/server.js"
    },
    {
      "source": "/students",
      "destination": "/MUYAR_PRACTICAL/client/server/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/MUYAR_PRACTICAL/client/$1"
    }
  ]
}